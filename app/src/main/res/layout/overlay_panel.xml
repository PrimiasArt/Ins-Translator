<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Compatibility stub for scrim (non-blocking) -->
    <View
        android:id="@+id/scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <!-- Draggable Header -->
                <RelativeLayout
                    android:id="@+id/layoutHeader"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="⠿"
                            android:textColor="?attr/overlayTextSecondaryColor"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPanelAppTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ins Translator to Phyll"
                            android:textColor="?attr/overlayTextColor"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnSettings"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Settings"
                            android:src="@drawable/ic_settings"
                            app:tint="?attr/overlayIconTint" />

                        <ImageButton
                            android:id="@+id/btnCollapse"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Collapse"
                            android:src="@drawable/ic_close"
                            app:tint="?attr/overlayIconTint" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Top Row: Mode Toggle & Persona Style -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <!-- Mode Toggle: Dịch đến / Dịch đi -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_toggle_track"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/tabIncoming"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_toggle_selected"
                            android:gravity="center"
                            android:text="📥 Tin đến"
                            android:textColor="@color/on_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tabOutgoing"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="📤 Tin đi"
                            android:textColor="?attr/overlayTextSecondaryColor"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Persona Selector -->
                    <Spinner
                        android:id="@+id/spinnerPersonaStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="0.9"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="6dp" />

                </LinearLayout>

                <!-- Source text input with compact utility buttons -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/inputSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:gravity="top"
                        android:hint="Dán hoặc nhập tin nhắn..."
                        android:inputType="textMultiLine"
                        android:maxLines="4"
                        android:minLines="2"
                        android:padding="10dp"
                        android:paddingEnd="106dp"
                        android:textColor="?attr/overlayTextColor"
                        android:textColorHint="?attr/overlayTextSecondaryColor"
                        android:textSize="14sp" />

                    <!-- Quick OCR Camera, Voice Mic & Audio TTS for Source -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCropScan"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="3dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="📸"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMic"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="3dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="🎙"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeakSource"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="🔊"
                            android:textSize="12sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Language Selectors & Action Buttons Row (Compact Single Row) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Source Language -->
                    <AutoCompleteTextView
                        android:id="@+id/langSourceSelector"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:completionThreshold="1"
                        android:hint="Auto Detect"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:textColor="?attr/overlayTextColor"
                        android:textColorHint="?attr/overlayTextSecondaryColor"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:text="➔"
                        android:textColor="?attr/overlayTextSecondaryColor"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Target Language -->
                    <AutoCompleteTextView
                        android:id="@+id/langSelector"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:completionThreshold="1"
                        android:hint="Ngôn ngữ đích"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:textColor="?attr/overlayTextColor"
                        android:textColorHint="?attr/overlayTextSecondaryColor"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Quick Translate Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTranslate"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="⚡ Dịch"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Paste & Translate Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaste"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="📋 Dán"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Hidden stubs for labels to keep full backward compatibility -->
                <TextView
                    android:id="@+id/txtSourceLangLabel"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtLangLabel"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="4dp"
                    android:visibility="gone" />

                <!-- Error text -->
                <TextView
                    android:id="@+id/txtError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="@color/error"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Result Box -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/txtResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_result"
                        android:minLines="2"
                        android:padding="10dp"
                        android:paddingEnd="76dp"
                        android:textColor="?attr/overlayTextColor"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEvalSpeech"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="3dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="🎯"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeakResult"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="🔊"
                            android:textSize="12sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Actions under result: Bookmark ⭐ & Copy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBookmark"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="⭐ Lưu từ"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopy"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="📋 Copy"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Collapsible Grammar Analysis Section -->
                <TextView
                    android:id="@+id/lblAnalysisHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:text="💡 Xem giải thích &amp; ngữ pháp ▼"
                    android:textColor="?attr/overlayTextSecondaryColor"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:textColor="?attr/overlayTextColor"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
